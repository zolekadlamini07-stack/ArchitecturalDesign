<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Payments MODULE: one business capability with its own code, its own schema and its own public API.
    Everything in this project is 'internal' EXCEPT the PublicApi folder and the PaymentsModule class.
    That means the C# compiler itself stops other modules from using our internals (D3).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\FoodDelivery.BuildingBlocks.csproj" />
    <!-- Q3: Payments' own public contract (events + support API) lives in a separate small project. -->
    <ProjectReference Include="..\Payments.Contracts\FoodDelivery.Modules.Payments.Contracts.csproj" />
    <!-- Q3: Payments now LISTENS to Ordering's events (OrderPlaced starts the payment). -->
    <ProjectReference Include="..\Ordering\FoodDelivery.Modules.Ordering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Q3: timeout + circuit breaker around the payment provider (D21). -->
    <PackageReference Include="Polly.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- This module's tables. Compiled into the DLL and run at startup (IF NOT EXISTS). -->
    <EmbeddedResource Include="Data\schema.sql" />
  </ItemGroup>
</Project>
