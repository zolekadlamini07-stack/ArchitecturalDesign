  <diagram id="page-2" name="Q3 - Order and payment states">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Q3 state machines: Ordering owns ORDER state, Payments owns PAYMENT state; they agree via events" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;Order states&lt;/b&gt; (ordering schema) - restaurant only sees an order from AWAITING_ACCEPTANCE onwards" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="380" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;PAYMENT_PENDING&lt;/b&gt;&lt;br&gt;[CHANGED Q3, was PLACED]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;PAYMENT_FAILED&lt;/b&gt;&lt;br&gt;(final, any late hold voided)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;AWAITING_ACCEPTANCE&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;(hold voided)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="320" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;ACCEPTED&lt;/b&gt;&lt;br&gt;(capture in background)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="630" y="160" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;PREPARING&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b&gt;READY_FOR_PICKUP&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;OUT_FOR_DELIVERY&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1060" y="320" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1330" y="320" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;(void or refund)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="630" y="320" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="e13" value="PaymentAuthorised" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="PaymentDeclined, or&lt;br&gt;10-min window expired" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="restaurant accepts" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b5" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="restaurant rejects" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="DeliveryPickedUp" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="DeliveryCompleted" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="support / customer cancel" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="b7" target="b12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t22" value="Transitions are idempotent: a repeated event for a state already reached is ignored; a transition that goes backwards is rejected." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="395" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="b23" value="&lt;b&gt;Payment attempt states&lt;/b&gt; (payments schema: payment_attempts + append-only payment_events) [NEW Q3]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1500" height="380" as="geometry"/></mxCell>
        <mxCell id="b24" value="&lt;b&gt;REQUESTED&lt;/b&gt;&lt;br&gt;row written first" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="570" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="b25" value="&lt;b&gt;IN_FLIGHT&lt;/b&gt;&lt;br&gt;written BEFORE the call" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="570" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="b26" value="&lt;b&gt;AUTHORISED&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="520" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="b27" value="&lt;b&gt;DECLINED&lt;/b&gt;&lt;br&gt;(final)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="620" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="b28" value="&lt;b&gt;UNKNOWN&lt;/b&gt;&lt;br&gt;timeout / 5xx / no reply&lt;br&gt;(resolved by reconciliation)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="720" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="b29" value="&lt;b&gt;CAPTURED&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="900" y="520" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="b30" value="&lt;b&gt;VOIDED&lt;/b&gt;&lt;br&gt;(final, never charged)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="b31" value="&lt;b&gt;REFUNDED&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1180" y="520" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="e32" value="worker picks job" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b24" target="b25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="provider: yes" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b25" target="b26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="provider: no" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b25" target="b27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="no answer" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="b25" target="b28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e36" value="reconciled: yes" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="b28" target="b26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="737"/><mxPoint x="595" y="564"/></Array></mxGeometry></mxCell>
        <mxCell id="e37" value="reconciled: no" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b28" target="b27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="758"/></Array></mxGeometry></mxCell>
        <mxCell id="e38" value="OrderAccepted -&amp;gt; capture" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b26" target="b29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e39" value="OrderRejected, or order&lt;br&gt;already given up" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b26" target="b30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="564"/><mxPoint x="840" y="667"/></Array></mxGeometry></mxCell>
        <mxCell id="e40" value="refund (compensation)" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b29" target="b31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t41" value="UNKNOWN is never shown to anyone as &quot;failed&quot;. While a payment is UNKNOWN, the order simply stays PAYMENT_PENDING (&quot;Confirming your payment...&quot;)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="800" width="880" height="30" as="geometry"/></mxCell>
      </root>
