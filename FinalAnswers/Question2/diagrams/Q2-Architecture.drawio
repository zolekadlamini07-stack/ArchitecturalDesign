<mxfile host="app.diagrams.net" type="device">
  <diagram id="page-1" name="Q2 - Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1150" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Q2 - Same modular monolith, plus cache, worker + job queue, read replica, rolling deploys" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1540" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="15 -&amp;gt; 50 restaurants | 5 devs | still one city. Every addition below answers one observed problem (P1-P7)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1540" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Web client&lt;/b&gt; - one responsive web app / PWA (D10). The client is never trusted for prices or roles." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1440" height="110" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Customer view&lt;/b&gt;&lt;br&gt;browse, basket, place order, track, history" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Restaurant dashboard&lt;/b&gt;&lt;br&gt;menu, incoming orders, accept/reject, status" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="415" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;Driver view&lt;/b&gt;&lt;br&gt;shift on/off, delivery requests, accept, status" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;Business / admin view&lt;/b&gt;&lt;br&gt;orders, revenue, deliveries completed" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1125" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;Modular monolith&lt;/b&gt; - ONE codebase, ONE release (D1). The same code is started as an API process OR a Worker process (D13)." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1440" height="610" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b&gt;API process&lt;/b&gt; - 2+ instances behind load balancer, rolling deploys, /health (D15) [CHANGED Q2]&lt;br&gt;HTTPS + JSON, clients poll (D8); route -&amp;gt; one slice. Never calls the payment provider." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="690" height="60" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;Worker process&lt;/b&gt; [NEW Q2] - same code, runs jobs from the PostgreSQL queue:&lt;br&gt;outbox dispatcher, notifications, cross-module event handlers, nightly summary" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="245" width="690" height="60" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; RegisterCustomer, Login, Logout,&lt;br&gt;CreateStaffAccount, CreateDriverAccount,&lt;br&gt;ApproveRestaurant -&amp;gt; staff account [Q2]&lt;br&gt;&lt;br&gt;API: verifyToken()&lt;br&gt;owns: identity" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; GetMyProfile, UpdateMyProfile,&lt;br&gt;AddAddress, ListAddresses&lt;br&gt;&lt;br&gt;API: getDeliveryAddress()&lt;br&gt;owns: customers" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b13" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; Notify - runs in WORKER, async,&lt;br&gt;retries + dead-letter, idempotent&lt;br&gt;(event_id, recipient) [CHANGED Q2]&lt;br&gt;&lt;br&gt;owns: notifications (log)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b14" value="&lt;b&gt;Restaurants (incl. Menu)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; BrowseRestaurants, GetMenu,&lt;br&gt;Add/Update/RemoveMenuItem,&lt;br&gt;SetItemAvailability, SetOpenStatus&lt;br&gt;cache-aside + invalidate [CHANGED Q2]&lt;br&gt;ApplyAsRestaurant [NEW Q2]&lt;br&gt;&lt;br&gt;API: getPricedItems() (DB, never cache)&lt;br&gt;owns: restaurants" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b15" value="&lt;b&gt;Reporting&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; OrdersAndRevenue, DeliveriesCompleted,&lt;br&gt;DailySummary&lt;br&gt;reads REPLICA + daily_summary&lt;br&gt;[CHANGED Q2]&lt;br&gt;&lt;br&gt;owns: nothing (+ daily_summary)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b16" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; StartShift, EndShift,&lt;br&gt;ListDeliveryRequests, AcceptDelivery,&lt;br&gt;MarkPickedUp, MarkDelivered,&lt;br&gt;ListMyDeliveries&lt;br&gt;&lt;br&gt;API: requestDelivery()&lt;br&gt;events: DeliveryPickedUp, DeliveryCompleted&lt;br&gt;owns: delivery" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b17" value="&lt;b&gt;Ordering&lt;/b&gt; (owns the Order state machine)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; QuoteBasket, PlaceOrder, TrackOrder,&lt;br&gt;Accept/RejectOrder, MarkPreparing,&lt;br&gt;MarkReady, ListMyOrders, ListIncoming&lt;br&gt;&lt;br&gt;API: acceptOrder()...&amp;nbsp;&amp;nbsp;events: OrderPlaced,&lt;br&gt;OrderAccepted... (via outbox [Q2])&lt;br&gt;owns: ordering" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b18" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; authorise (at checkout), capture (on&lt;br&gt;accept), void (on reject), refund&lt;br&gt;port: PaymentProvider&lt;br&gt;adapter: StripePaymentProvider&lt;br&gt;&lt;br&gt;API: authorise() capture() void()&lt;br&gt;owns: payments" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b19" value="&lt;b&gt;PostgreSQL (managed)&lt;/b&gt; - ONE database, ONE schema per module; each module writes ONLY its own schema (D4)&lt;br&gt;One DB role per module, write-only to own schema [NEW Q2] (D17)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1100" height="160" as="geometry"/></mxCell>
        <mxCell id="b20" value="identity" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b21" value="customers" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b22" value="restaurants" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="325" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b23" value="ordering" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b24" value="payments" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="595" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b25" value="delivery" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="730" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b26" value="notifications" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="865" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b27" value="outbox + jobs&lt;br&gt;[NEW Q2]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1000" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b28" value="&lt;b&gt;Push / email provider&lt;/b&gt;&lt;br&gt;(e.g. Firebase Cloud Messaging + email API)&lt;br&gt;behind Notifier adapter" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="220" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="b29" value="&lt;b&gt;Payment provider&lt;/b&gt; (e.g. Stripe)&lt;br&gt;hosted card fields, manual capture" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="640" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="t30" value="&lt;b&gt;External systems&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e32" value="card tokenised in browser (hosted fields) - card data never reaches us" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="135"/><mxPoint x="30" y="195"/><mxPoint x="1890" y="195"/><mxPoint x="1890" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="e33" value="getPricedItems()" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="authorise / capture / void&lt;br&gt;(in-process call)" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="requestDelivery()" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e36" value="events (durable, via outbox)" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e37" value="events via outbox -&amp;gt; job" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e38" value="HTTPS via Notifier adapter" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="325"/><mxPoint x="1710" y="325"/></Array></mxGeometry></mxCell>
        <mxCell id="e39" value="HTTPS via PaymentProvider&lt;br&gt;adapter, 10 s timeout" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e40" value="each module: own schema only" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3927272727272727;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b8" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b41" value="&lt;b&gt;CDN&lt;/b&gt; for static files (JS/CSS/images) [NEW Q2]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="80" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e42" value="static assets" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b41" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b43" value="&lt;b&gt;Redis (managed)&lt;/b&gt; cache-aside [NEW Q2] (D11)&lt;br&gt;menu:{restaurantId}, restaurants:list&lt;br&gt;TTL 5 min + delete on change&lt;br&gt;display only - never used for prices" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="370" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="e44" value="get / set / delete" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b45" value="&lt;b&gt;Read replica&lt;/b&gt; [NEW Q2] (D14)&lt;br&gt;streaming replication,&lt;br&gt;seconds of lag&lt;br&gt;used ONLY by Reporting" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1"><mxGeometry x="1180" y="860" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="e46" value="replicates" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="b19" target="b45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e47" value="Reporting: read-only queries" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b15" target="b45"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="25" y="710"/><mxPoint x="25" y="1065"/><mxPoint x="1330" y="1065"/></Array></mxGeometry></mxCell>
        <mxCell id="t48" value="worker takes jobs (FOR UPDATE SKIP LOCKED), retries with backoff, dead-letter" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="1022" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="e49" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.95;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b10" target="b19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="275"/><mxPoint x="1520" y="1045"/><mxPoint x="1085" y="1045"/></Array></mxGeometry></mxCell>
        <mxCell id="b50" value="&lt;b&gt;CI pipeline&lt;/b&gt; (e.g. GitHub Actions) [NEW Q2]&lt;br&gt;tests + architecture tests on every PR -&amp;gt;&lt;br&gt;rolling deploy; expand/contract migrations;&lt;br&gt;feature flags (D15, D16)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="1015" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="b51" value="Legend" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="860" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="b52" value="Existing component" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1570" y="890" width="140" height="30" as="geometry"/></mxCell>
        <mxCell id="b53" value="New in Q2" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1730" y="890" width="140" height="30" as="geometry"/></mxCell>
        <mxCell id="t54" value="[NEW Q2] / [CHANGED Q2] tags mark what moved at this stage.&lt;br&gt;Solid arrow = call / command. Dashed arrow = event, async or read-only." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1570" y="926" width="315" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-2" name="Q2 - Place order and browse flows">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1150" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Q2 flows: (A) notifications leave the request path via outbox + job queue; (B) browsing uses cache-aside" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;(A) Customer places an order - BEFORE (Q1): notify() inside the request&lt;/b&gt; (problem P3)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="130" as="geometry"/></mxCell>
        <mxCell id="b3" value="PlaceOrder slice&lt;br&gt;price + authorise" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="b4" value="save order" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="Notifications.notify()&lt;br&gt;waits 100-500 ms+ for provider" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="b6" value="return response&lt;br&gt;(slow; slower when provider is slow)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;(A) AFTER (Q2): durable event + background job&lt;/b&gt; (D12, D13)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1500" height="330" as="geometry"/></mxCell>
        <mxCell id="t11" value="API process" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="b12" value="PlaceOrder slice&lt;br&gt;price + authorise" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="b13" value="ONE transaction:&lt;br&gt;insert order&lt;br&gt;+ insert outbox(OrderPlaced)&lt;br&gt;COMMIT" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="b14" value="return 201&lt;br&gt;(fast - no provider wait)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="630" y="270" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b13" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t17" value="Worker process" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="b18" value="Outbox dispatcher&lt;br&gt;reads new outbox rows&lt;br&gt;-&amp;gt; one job per subscriber" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="330" y="410" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="b19" value="Job: NotifyRestaurant&lt;br&gt;OfNewOrder" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="630" y="410" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="b20" value="Push provider" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="920" y="410" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="b21" value="Fails? retry with backoff&lt;br&gt;10 s, 30 s, 2 min ... then&lt;br&gt;dead-letter + alert.&lt;br&gt;Idempotent: unique&lt;br&gt;(event_id, recipient)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1170" y="395" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="e22" value="committed rows" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b18" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" value="send" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b19" target="b20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="error" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="b20" target="b21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t26" value="If the process crashes after COMMIT, the outbox row is still there, so the notification is never lost. No dual write: order and event are saved atomically in the same database." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="b27" value="&lt;b&gt;(B) Browse restaurants / view menu - cache-aside&lt;/b&gt; (D11)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1500" height="260" as="geometry"/></mxCell>
        <mxCell id="b28" value="GetMenu slice" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="620" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="b29" value="Redis: get menu:{id}" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="620" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="b30" value="HIT -&amp;gt; return cached menu" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="590" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="b31" value="MISS -&amp;gt; read PostgreSQL,&lt;br&gt;set menu:{id} TTL 5 min, return" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="670" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="e32" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b28" target="b29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="hit" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b29" target="b30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="miss" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b29" target="b31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b35" value="UpdateMenuItem /&lt;br&gt;SetItemAvailability slice" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="b36" value="save in DB, COMMIT,&lt;br&gt;then delete menu:{id}" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="600" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="e37" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b35" target="b36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t38" value="Safety rule: PlaceOrder never prices from the cache - it calls Restaurants.getPricedItems() which reads the database. A stale cache can only affect what is displayed, never what is charged. TTL is the safety net if a delete is missed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="690" width="540" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
