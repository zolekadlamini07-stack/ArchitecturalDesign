  <diagram id="page-3" name="Q3 - Timeout and recovery sequence">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Friday night: payment times out, actually succeeded, customer clicks again, worker crashes, provider recovers" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1550" height="30" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;Customer (browser)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="370" height="1130" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;API process - Ordering&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="50" width="370" height="1130" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Worker - Payments queue&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="800" y="50" width="370" height="1130" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Payment provider&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1180" y="50" width="370" height="1130" as="geometry"/></mxCell>
        <mxCell id="b6" value="1. Place Order&lt;br&gt;Idempotency-Key: K" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b7" value="2. TX: place_order_requests(K), order&lt;br&gt;PAYMENT_PENDING, outbox OrderPlaced. 202" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b8" value="3. &quot;Confirming your payment...&quot;&lt;br&gt;polls GET /orders/{id}" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b9" value="4. TX: attempt A = REQUESTED -&amp;gt; IN_FLIGHT&lt;br&gt;log &quot;request sent&quot;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="180" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b10" value="5. authorise, Idempotency-Key = A&lt;br&gt;... provider struggling ..." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="180" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b11" value="6. 10 s timeout -&amp;gt; A = UNKNOWN&lt;br&gt;(NOT failed). Breaker counts it.&lt;br&gt;Schedule reconciliation." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="280" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="b12" value="7. Provider actually AUTHORISED A&lt;br&gt;(response lost)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="280" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="b13" value="8. Customer clicks again (same K)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b14" value="9. K exists -&amp;gt; return SAME order&lt;br&gt;(no new order, no new payment)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="380" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b15" value="10. Refreshes, new key K2" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b16" value="11. One PAYMENT_PENDING order per&lt;br&gt;customer (DB index) -&amp;gt; show existing" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b17" value="12. Breaker OPEN (too many failures):&lt;br&gt;no provider calls; jobs rescheduled.&lt;br&gt;API, browsing, restaurants unaffected." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="b18" value="13. Provider recovers" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="660" width="330" height="50" as="geometry"/></mxCell>
        <mxCell id="b19" value="14. Breaker HALF-OPEN: trial calls OK&lt;br&gt;-&amp;gt; CLOSED. Backlog drains at the&lt;br&gt;queue concurrency limit (+ jitter)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="b20" value="15. Sweeper: replay A with SAME key" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="760" width="330" height="50" as="geometry"/></mxCell>
        <mxCell id="b21" value="16. Same key -&amp;gt; returns original&lt;br&gt;&quot;authorised&quot;. No second charge." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="760" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b22" value="17. Worker crashes before saving?&lt;br&gt;Job lease expires -&amp;gt; re-run -&amp;gt; same&lt;br&gt;key -&amp;gt; same answer. Then ONE TX:&lt;br&gt;A = AUTHORISED + outbox PaymentAuthorised" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="850" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="b23" value="Also: webhook for A arrives&lt;br&gt;-&amp;gt; inbox dedupes it" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="960" width="330" height="50" as="geometry"/></mxCell>
        <mxCell id="b24" value="18. PaymentAuthorised: order still in&lt;br&gt;10-min window -&amp;gt; AWAITING_ACCEPTANCE&lt;br&gt;(outside window -&amp;gt; stay failed, VOID A)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="960" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="b25" value="19. &quot;Waiting for the restaurant&quot;&lt;br&gt;(or &quot;hold released, not charged&quot;)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="b26" value="20. Restaurant sees order (poll + push)&lt;br&gt;Next day: settlement check matches" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="1070" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="506" y="210"/></Array></mxGeometry></mxCell>
        <mxCell id="e29" value="OrderPlaced job" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="b7" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e30" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="b10" target="b12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e32" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b9" target="b11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b13" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b15" target="b16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b11" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e36" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b18" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e37" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b19" target="b20"><mxGeometry relative="1" as="geometry"/></mxCell>
