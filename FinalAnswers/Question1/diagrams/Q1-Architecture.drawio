  <diagram id="page-2" name="Q1 - Inside a module (vertical slices)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1150" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Inside the Ordering module: why we moved from layers (horizontal) to vertical slices" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="Modules are cut vertically by business capability; slices cut each module vertically again by use case. Same direction of cut at both levels." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;BEFORE (earlier answers): Pragmatic Layered - horizontal&lt;/b&gt;&lt;br&gt;One feature (PlaceOrder) needs edits in ALL four layers; every feature shares the same big files." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="560" height="520" as="geometry"/></mxCell>
        <mxCell id="b4" value="presentation/&amp;nbsp;&amp;nbsp; OrderController" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="application/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;OrderService (PlaceOrder, AcceptOrder, Track...)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="255" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="b6" value="domain/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Order, OrderItem, IOrderRepository" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="b7" value="infrastructure/ PostgresOrderRepository" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="465" width="500" height="70" as="geometry"/></mxCell>
