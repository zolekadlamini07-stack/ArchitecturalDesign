<mxfile host="app.diagrams.net" type="device">
  <diagram id="page-1" name="Q3 - Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Q3 - Same topology; Payments and Ordering made resilient (ledger, idempotency, circuit breaker, reconciliation)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1540" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="50 restaurants | 3 cities | 12 devs in 2 teams. Team A = Ordering &amp;amp; Payments side; Team B = Restaurants &amp;amp; Delivery side." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1540" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Web client&lt;/b&gt; - one responsive web app / PWA (D10). The client is never trusted for prices or roles." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1440" height="110" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Customer view&lt;/b&gt;&lt;br&gt;browse, basket, place order, track, history&lt;br&gt;sends Idempotency-Key per checkout [CHANGED Q3]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Restaurant dashboard&lt;/b&gt;&lt;br&gt;menu, incoming orders, accept/reject, status" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="415" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;Driver view&lt;/b&gt;&lt;br&gt;shift on/off, delivery requests, accept, status" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;Business / admin view&lt;/b&gt;&lt;br&gt;orders, revenue, deliveries completed&lt;br&gt;support: order timeline [NEW Q3]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1125" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;Modular monolith&lt;/b&gt; - ONE codebase, ONE release (D1). The same code is started as an API process OR a Worker process (D13)." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1440" height="610" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b&gt;API process&lt;/b&gt; - 2+ instances behind load balancer, rolling deploys, /health (D15) [CHANGED Q2]&lt;br&gt;HTTPS + JSON, clients poll (D8); route -&amp;gt; one slice. Never calls the payment provider [Q3]." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="690" height="60" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;Worker process&lt;/b&gt; - separate queues, each with its own concurrency limit (bulkhead) [CHANGED Q3]:&lt;br&gt;payments | notifications | integration | reporting" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="245" width="690" height="60" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;Identity&lt;/b&gt;&amp;nbsp;&amp;nbsp;(Team A)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; RegisterCustomer, Login, Logout,&lt;br&gt;CreateStaffAccount, CreateDriverAccount,&lt;br&gt;ApproveRestaurant -&amp;gt; staff account [Q2]&lt;br&gt;&lt;br&gt;API: verifyToken()&lt;br&gt;owns: identity" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;b&gt;Customers&lt;/b&gt;&amp;nbsp;&amp;nbsp;(Team A)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; GetMyProfile, UpdateMyProfile,&lt;br&gt;AddAddress, ListAddresses&lt;br&gt;&lt;br&gt;API: getDeliveryAddress()&lt;br&gt;owns: customers" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b13" value="&lt;b&gt;Notifications&lt;/b&gt;&amp;nbsp;&amp;nbsp;(Team A)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; Notify - runs in WORKER, async,&lt;br&gt;retries + dead-letter, idempotent&lt;br&gt;(event_id, recipient) [CHANGED Q2]&lt;br&gt;&lt;br&gt;owns: notifications (log)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b14" value="&lt;b&gt;Restaurants (incl. Menu)&lt;/b&gt;&amp;nbsp;&amp;nbsp;(Team B)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; BrowseRestaurants, GetMenu,&lt;br&gt;Add/Update/RemoveMenuItem,&lt;br&gt;SetItemAvailability, SetOpenStatus&lt;br&gt;cache-aside + invalidate [CHANGED Q2]&lt;br&gt;ApplyAsRestaurant [NEW Q2]&lt;br&gt;city_id, browse by city [Q3]&lt;br&gt;&lt;br&gt;API: getPricedItems() (DB, never cache)&lt;br&gt;owns: restaurants" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b15" value="&lt;b&gt;Reporting&lt;/b&gt;&amp;nbsp;&amp;nbsp;(Team B)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; OrdersAndRevenue, DeliveriesCompleted,&lt;br&gt;DailySummary&lt;br&gt;reads REPLICA + daily_summary&lt;br&gt;[CHANGED Q2]&lt;br&gt;per city [Q3]&lt;br&gt;&lt;br&gt;owns: nothing (+ daily_summary)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b16" value="&lt;b&gt;Delivery&lt;/b&gt;&amp;nbsp;&amp;nbsp;(Team B)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; StartShift, EndShift,&lt;br&gt;ListDeliveryRequests, AcceptDelivery,&lt;br&gt;MarkPickedUp, MarkDelivered,&lt;br&gt;ListMyDeliveries&lt;br&gt;&lt;br&gt;API: requestDelivery()&lt;br&gt;events: DeliveryPickedUp, DeliveryCompleted&lt;br&gt;owns: delivery" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b17" value="&lt;b&gt;Ordering&lt;/b&gt; (owns the Order state machine)&amp;nbsp;&amp;nbsp;(Team A)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; [CHANGED Q3] PlaceOrder: save order as&lt;br&gt;PAYMENT_PENDING + outbox, return 202;&lt;br&gt;Idempotency-Key; 1 pending order/customer&lt;br&gt;Accept/RejectOrder, MarkPreparing,&lt;br&gt;MarkReady, ListMyOrders, ListIncoming,&lt;br&gt;GetOrderTimeline [NEW Q3]&lt;br&gt;&lt;br&gt;events via outbox | owns: ordering" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b18" value="&lt;b&gt;Payments&lt;/b&gt;&amp;nbsp;&amp;nbsp;(Team A)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; [CHANGED Q3] AuthoriseOnOrderPlaced&lt;br&gt;(worker), Capture, Void, Refund,&lt;br&gt;ReceiveProviderWebhook,&lt;br&gt;ReconciliationSweeper, DailySettlement&lt;br&gt;ledger with UNKNOWN state,&lt;br&gt;idempotency key, circuit breaker&lt;br&gt;&lt;br&gt;events via outbox | owns: payments" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b19" value="&lt;b&gt;PostgreSQL (managed)&lt;/b&gt; - ONE database, ONE schema per module; each module writes ONLY its own schema (D4)&lt;br&gt;One DB role per module, write-only to own schema [NEW Q2] (D17)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1100" height="160" as="geometry"/></mxCell>
        <mxCell id="b20" value="identity" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b21" value="customers" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b22" value="restaurants&lt;br&gt;(+ city)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="325" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b23" value="ordering&lt;br&gt;+ place_order&lt;br&gt;_requests" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b24" value="payments:&lt;br&gt;attempts, events,&lt;br&gt;webhook_inbox" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="595" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b25" value="delivery" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="730" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b26" value="notifications" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="865" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b27" value="outbox + jobs&lt;br&gt;queue" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1000" y="925" width="125" height="80" as="geometry"/></mxCell>
        <mxCell id="b28" value="&lt;b&gt;Push / email provider&lt;/b&gt;&lt;br&gt;(e.g. Firebase Cloud Messaging + email API)&lt;br&gt;behind Notifier adapter" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="220" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="b29" value="&lt;b&gt;Payment provider&lt;/b&gt; (e.g. Stripe)&lt;br&gt;hosted card fields, manual capture,&lt;br&gt;idempotency keys, webhooks,&lt;br&gt;daily settlement report" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="640" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="t30" value="&lt;b&gt;External systems&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e32" value="card tokenised in browser (hosted fields) - card data never reaches us" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="135"/><mxPoint x="30" y="195"/><mxPoint x="1890" y="195"/><mxPoint x="1890" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="e33" value="getPricedItems()" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="OrderPlaced,&lt;br&gt;OrderAccepted" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="PaymentAuthorised,&lt;br&gt;PaymentDeclined" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e36" value="requestDelivery()" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e37" value="events (durable, via outbox)" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e38" value="events via outbox -&amp;gt; job" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e39" value="HTTPS via Notifier adapter" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="325"/><mxPoint x="1710" y="325"/></Array></mxGeometry></mxCell>
        <mxCell id="e40" value="calls" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e41" value="webhooks" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.65;exitDx=0;exitDy=0;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="b29" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e42" value="reconcile" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0;entryY=0.92;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t43" value="&lt;b&gt;Payments &amp;lt;-&amp;gt; provider [CHANGED Q3]&lt;/b&gt;&lt;br&gt;calls: authorise / capture / void, from the WORKER only;&lt;br&gt;10 s timeout, circuit breaker, same idempotency key&lt;br&gt;webhooks: verified, stored in inbox (dedupe)&lt;br&gt;reconcile: sweeper for UNKNOWN + daily settlement" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1560" y="765" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="e44" value="each module: own schema only" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3927272727272727;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b8" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b45" value="&lt;b&gt;CDN&lt;/b&gt; for static files (JS/CSS/images) [NEW Q2]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="80" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e46" value="static assets" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b45" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b47" value="&lt;b&gt;Redis (managed)&lt;/b&gt; cache-aside [NEW Q2] (D11)&lt;br&gt;menu:{restaurantId}, restaurants:list&lt;br&gt;TTL 5 min + delete on change&lt;br&gt;display only - never used for prices" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="370" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="e48" value="get / set / delete" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b49" value="&lt;b&gt;Read replica&lt;/b&gt; [NEW Q2] (D14)&lt;br&gt;streaming replication,&lt;br&gt;seconds of lag&lt;br&gt;used ONLY by Reporting" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1"><mxGeometry x="1180" y="860" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="e50" value="replicates" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="b19" target="b49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e51" value="Reporting: read-only queries" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b15" target="b49"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="25" y="710"/><mxPoint x="25" y="1065"/><mxPoint x="1330" y="1065"/></Array></mxGeometry></mxCell>
        <mxCell id="t52" value="worker takes jobs (FOR UPDATE SKIP LOCKED), retries with backoff, dead-letter" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="1022" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="e53" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.95;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b10" target="b19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="275"/><mxPoint x="1520" y="1045"/><mxPoint x="1085" y="1045"/></Array></mxGeometry></mxCell>
        <mxCell id="b54" value="&lt;b&gt;CI pipeline&lt;/b&gt; (e.g. GitHub Actions) [NEW Q2]&lt;br&gt;tests + architecture tests on every PR -&amp;gt;&lt;br&gt;rolling deploy; expand/contract migrations;&lt;br&gt;feature flags (D15, D16)&lt;br&gt;+ contract tests per team [Q3]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="1015" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="b55" value="Legend" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="860" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="b56" value="Existing component" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1570" y="890" width="140" height="30" as="geometry"/></mxCell>
