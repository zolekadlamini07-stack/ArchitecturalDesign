<mxfile host="app.diagrams.net" type="device">
  <diagram id="page-1" name="Challenge - Integration via Anti-Corruption Layer">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="950" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Challenge: integrating the acquired platform without rewriting either side - one new module (ACL)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1550" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="Our platform is unchanged except for one new module. Their platform is untouched. No shared database. Each side owns its own data." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1550" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;OUR PLATFORM&lt;/b&gt; - modular monolith (from Q3)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="900" height="820" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Restaurants&lt;/b&gt;&lt;br&gt;stores partner restaurants as a&lt;br&gt;READ-ONLY copy, source = PARTNER&lt;br&gt;API: upsertPartnerRestaurant()" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Ordering&lt;/b&gt;&lt;br&gt;unchanged flow; order has generic&lt;br&gt;fulfilment = OWN | PARTNER&lt;br&gt;API: acceptOrder() rejectOrder()...&lt;br&gt;event: OrderAwaitingAcceptance" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="130" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;unchanged Q3 flow - our customers&lt;br&gt;pay us for partner-restaurant&lt;br&gt;orders too (D29)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;Reporting&lt;/b&gt;&lt;br&gt;Our / Acquired / Total&lt;br&gt;(partner_daily_summary)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;br&gt;not used for PARTNER orders&lt;br&gt;(their drivers deliver)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="670" y="260" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="e9" value="events (Q3)" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;PartnerIntegration module&lt;/b&gt; = Anti-Corruption Layer [NEW] (D26)&lt;br&gt;the ONLY code that knows the acquired platform exists; runs its calls on the worker &quot;integration&quot; queue" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;dashed=1;dashPattern=6 4;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="860" height="470" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;features/sync-partner-catalogue&lt;/b&gt;&lt;br&gt;every few minutes + on their webhook;&lt;br&gt;last-known-good copy (D27)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;b&gt;features/forward-order&lt;/b&gt;&lt;br&gt;on OrderAwaitingAcceptance (PARTNER);&lt;br&gt;idempotency key = our order id;&lt;br&gt;not confirmed in 10 min -&amp;gt; reject -&amp;gt; void" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="360" y="470" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="b13" value="&lt;b&gt;features/receive-partner-webhook&lt;/b&gt;&lt;br&gt;verify, store in partner_inbox (dedupe),&lt;br&gt;translate status -&amp;gt; our Ordering API" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="240" height="85" as="geometry"/></mxCell>
        <mxCell id="b14" value="&lt;b&gt;features/pull-partner-reports&lt;/b&gt;&lt;br&gt;nightly daily totals -&amp;gt; Reporting" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="575" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="b15" value="&lt;b&gt;translation/&lt;/b&gt; their model &amp;lt;-&amp;gt; our model&lt;br&gt;ids via id_map | price_cents -&amp;gt; Money(ZAR) | status mapping table:&lt;br&gt;CONFIRMED-&amp;gt;ACCEPTED, COOKING-&amp;gt;PREPARING, DISPATCHED-&amp;gt;OUT_FOR_DELIVERY,&lt;br&gt;DONE-&amp;gt;DELIVERED | unknown value = alert, never a guess" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="360" y="575" width="540" height="90" as="geometry"/></mxCell>
        <mxCell id="b16" value="&lt;b&gt;adapter/PartnerApiClient&lt;/b&gt; - their URLs, auth, field names, pinned API version (D28);&lt;br&gt;timeouts, retries with backoff, circuit breaker; tolerant reader" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="820" height="60" as="geometry"/></mxCell>
        <mxCell id="b17" value="&lt;b&gt;partner_integration schema&lt;/b&gt;: id_map, partner_inbox, outbox" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1"><mxGeometry x="80" y="770" width="820" height="80" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.45;exitY=0;exitDx=0;exitDy=0;entryX=0.45;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b11" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t19" value="upsertPartnerRestaurant()" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="185" y="374" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="e20" value="OrderAwaitingAcceptance&lt;br&gt;(PARTNER)" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="acceptOrder / rejectOrder /&lt;br&gt;markPreparing / ..." style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="48" y="605"/><mxPoint x="48" y="185"/></Array></mxGeometry></mxCell>
        <mxCell id="b23" value="&lt;b&gt;ACQUIRED PLATFORM&lt;/b&gt; - unchanged, owns its own data" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="560" height="820" as="geometry"/></mxCell>
        <mxCell id="b24" value="&lt;b&gt;Their Restaurant system&lt;/b&gt;&lt;br&gt;source of truth for their restaurants + menus" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="b25" value="&lt;b&gt;Their Order system&lt;/b&gt;&lt;br&gt;receives forwarded orders (external_ref = our order id);&lt;br&gt;their restaurants accept in their tools; their drivers deliver" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1030" y="260" width="500" height="80" as="geometry"/></mxCell>
        <mxCell id="b26" value="&lt;b&gt;Their Customer system&lt;/b&gt;&lt;br&gt;not integrated in Phase 1 (account linking later, with consent)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1030" y="380" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="b27" value="&lt;b&gt;Their Payment system&lt;/b&gt;&lt;br&gt;not integrated: each platform charges for its own orders (D29)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1030" y="490" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="b28" value="Their customers keep using their own app" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1030" y="600" width="500" height="50" as="geometry"/></mxCell>
        <mxCell id="b29" value="&lt;b&gt;Contracts &amp;amp; versioning (D28)&lt;/b&gt;&lt;br&gt;pinned API version, consumer-driven contract tests (Pact) in their CI,&lt;br&gt;separate versioned /partner/v1 API if they ever need to call us" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1030" y="700" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="e30" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="702"/><mxPoint x="960" y="185"/></Array></mxGeometry></mxCell>
        <mxCell id="t31" value="&amp;lt;- sync catalogue (GET, every few minutes)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1005" y="122" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="e32" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="720"/><mxPoint x="975" y="292"/></Array></mxGeometry></mxCell>
        <mxCell id="t33" value="&amp;lt;- forward orders (POST, idempotent)&amp;nbsp;&amp;nbsp; |&amp;nbsp;&amp;nbsp; -&amp;gt; status webhooks" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1005" y="233" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="e34" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b25" target="b13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="324"/><mxPoint x="990" y="495"/></Array></mxGeometry></mxCell>
        <mxCell id="t35" value="NOT DONE: shared database, direct DB access, their model inside our modules, payment-system merge, rewrite." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1030" y="820" width="500" height="50" as="geometry"/></mxCell>
