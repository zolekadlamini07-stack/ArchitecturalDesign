<mxfile host="app.diagrams.net" type="device">
  <diagram id="page-1" name="Q1 - Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1150" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Q1 - Food Delivery Platform: Modular Monolith + Vertical Slices" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1540" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="1 restaurant | 3 devs | no DevOps | very limited budget. One deployable, one database, 8 modules, one folder per use case." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1540" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Web client&lt;/b&gt; - one responsive web app / PWA (D10). The client is never trusted for prices or roles." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1440" height="110" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Customer view&lt;/b&gt;&lt;br&gt;browse, basket, place order, track, history" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Restaurant dashboard&lt;/b&gt;&lt;br&gt;menu, incoming orders, accept/reject, status" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="415" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;Driver view&lt;/b&gt;&lt;br&gt;shift on/off, delivery requests, accept, status" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;Business / admin view&lt;/b&gt;&lt;br&gt;orders, revenue, deliveries completed" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1125" y="100" width="335" height="70" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;Modular monolith&lt;/b&gt; - ONE deployable on a managed PaaS (D1, D9). Modules talk only via public APIs (calls) and events." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1440" height="610" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b&gt;HTTP API&lt;/b&gt; (1 instance): HTTPS + JSON (REST), clients poll for status (D8) | routing + authentication (token carries role) | every route maps to exactly ONE slice" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; RegisterCustomer, Login, Logout,&lt;br&gt;CreateStaffAccount, CreateDriverAccount&lt;br&gt;&lt;br&gt;API: verifyToken()&lt;br&gt;owns: identity" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; GetMyProfile, UpdateMyProfile,&lt;br&gt;AddAddress, ListAddresses&lt;br&gt;&lt;br&gt;API: getDeliveryAddress()&lt;br&gt;owns: customers" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; Notify(user, template) - called&lt;br&gt;SYNCHRONOUSLY after the main&lt;br&gt;change is saved (Risk 3)&lt;br&gt;&lt;br&gt;owns: notifications (log)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b13" value="&lt;b&gt;Restaurants (incl. Menu)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; BrowseRestaurants, GetMenu,&lt;br&gt;Add/Update/RemoveMenuItem,&lt;br&gt;SetItemAvailability, SetOpenStatus&lt;br&gt;&lt;br&gt;API: getPricedItems() (DB, never cache)&lt;br&gt;owns: restaurants" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="340" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b14" value="&lt;b&gt;Reporting&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; OrdersAndRevenue, DeliveriesCompleted,&lt;br&gt;DailySummary&lt;br&gt;read-only SQL across schemas&lt;br&gt;&lt;br&gt;owns: nothing" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b15" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; StartShift, EndShift,&lt;br&gt;ListDeliveryRequests, AcceptDelivery,&lt;br&gt;MarkPickedUp, MarkDelivered,&lt;br&gt;ListMyDeliveries&lt;br&gt;&lt;br&gt;API: requestDelivery()&lt;br&gt;events: DeliveryPickedUp, DeliveryCompleted&lt;br&gt;owns: delivery" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b16" value="&lt;b&gt;Ordering&lt;/b&gt; (owns the Order state machine)&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; QuoteBasket, PlaceOrder, TrackOrder,&lt;br&gt;Accept/RejectOrder, MarkPreparing,&lt;br&gt;MarkReady, ListMyOrders, ListIncoming&lt;br&gt;&lt;br&gt;API: acceptOrder()...&amp;nbsp;&amp;nbsp;events: OrderPlaced,&lt;br&gt;OrderAccepted...&lt;br&gt;owns: ordering" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b17" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;slices:&lt;/b&gt; authorise (at checkout), capture (on&lt;br&gt;accept), void (on reject), refund&lt;br&gt;port: PaymentProvider&lt;br&gt;adapter: StripePaymentProvider&lt;br&gt;&lt;br&gt;API: authorise() capture() void()&lt;br&gt;owns: payments" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="610" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="b18" value="&lt;b&gt;PostgreSQL (managed)&lt;/b&gt; - ONE database, ONE schema per module; each module writes ONLY its own schema (D4)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1440" height="160" as="geometry"/></mxCell>
        <mxCell id="b19" value="identity" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="925" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="b20" value="customers" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="255" y="925" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="b21" value="restaurants" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="455" y="925" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="b22" value="ordering" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="655" y="925" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="b23" value="payments" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="855" y="925" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="b24" value="delivery" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1055" y="925" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="b25" value="notifications" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=10;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1255" y="925" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="b26" value="&lt;b&gt;Push / email provider&lt;/b&gt;&lt;br&gt;(e.g. Firebase Cloud Messaging + email API)&lt;br&gt;behind Notifier adapter" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="220" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="b27" value="&lt;b&gt;Payment provider&lt;/b&gt; (e.g. Stripe)&lt;br&gt;hosted card fields, manual capture" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="640" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="t28" value="&lt;b&gt;External systems&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e30" value="card tokenised in browser (hosted fields) - card data never reaches us" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="135"/><mxPoint x="30" y="195"/><mxPoint x="1890" y="195"/><mxPoint x="1890" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="e31" value="getPricedItems()" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e32" value="authorise / capture / void&lt;br&gt;(in-process call)" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="requestDelivery()" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="events (in-process)" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="b15" target="b16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="notify() - synchronous" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e36" value="HTTPS via Notifier adapter" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b12" target="b26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="325"/><mxPoint x="1710" y="325"/></Array></mxGeometry></mxCell>
        <mxCell id="e37" value="HTTPS via PaymentProvider&lt;br&gt;adapter, 10 s timeout" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e38" value="each module: own schema only" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b8" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e39" value="read-only across schemas" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.10416666666666667;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b40" value="Legend" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="860" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="b41" value="Existing component" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1570" y="890" width="140" height="30" as="geometry"/></mxCell>
        <mxCell id="b42" value="New component" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;dashed=1;dashPattern=6 4;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1730" y="890" width="140" height="30" as="geometry"/></mxCell>
        <mxCell id="t43" value="Solid arrow = call / command. Dashed arrow = event, async or read-only." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1570" y="926" width="315" height="70" as="geometry"/></mxCell>
