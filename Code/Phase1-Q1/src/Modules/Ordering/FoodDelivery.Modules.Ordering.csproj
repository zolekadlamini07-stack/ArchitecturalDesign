<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Ordering MODULE: one business capability with its own code, its own schema and its own public API.
    Everything in this project is 'internal' EXCEPT the PublicApi folder and the OrderingModule class.
    That means the C# compiler itself stops other modules from using our internals (D3).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\FoodDelivery.BuildingBlocks.csproj" />
    <!--
      Ordering is the heart of the system, so it USES several other modules - but only their
      PublicApi folders (everything else in those projects is 'internal' and invisible here).
      Note what is NOT here: nothing references Ordering back, so there are no circular dependencies.
    -->
    <ProjectReference Include="..\Customers\FoodDelivery.Modules.Customers.csproj" />
    <ProjectReference Include="..\Restaurants\FoodDelivery.Modules.Restaurants.csproj" />
    <ProjectReference Include="..\Payments\FoodDelivery.Modules.Payments.csproj" />
    <ProjectReference Include="..\Delivery\FoodDelivery.Modules.Delivery.csproj" />
    <ProjectReference Include="..\Notifications\FoodDelivery.Modules.Notifications.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>
  <ItemGroup>
    <!-- This module's tables. Compiled into the DLL and run at startup (IF NOT EXISTS). -->
    <EmbeddedResource Include="Data\schema.sql" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets the TEST project unit-test the Order rules. Other MODULES still cannot see internals. -->
    <InternalsVisibleTo Include="FoodDelivery.Tests" />
  </ItemGroup>
</Project>
