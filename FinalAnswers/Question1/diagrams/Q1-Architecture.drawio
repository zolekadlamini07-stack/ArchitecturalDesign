        <mxCell id="e9" value="depends on" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="depends on" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t11" value="PlaceOrder touches 4 folders. 5 developers working on 5 features all edit OrderService and OrderController -&amp;gt; merge conflicts (Q2 problem P6)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;b&gt;NOW: Pragmatic Vertical Slices&lt;/b&gt; - one folder per use case (D2)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=12;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="900" height="690" as="geometry"/></mxCell>
        <mxCell id="b13" value="&lt;b&gt;OrderingApi.ts&lt;/b&gt; (PUBLIC - the only thing other modules may call)&amp;nbsp;&amp;nbsp; +&amp;nbsp;&amp;nbsp; &lt;b&gt;events.ts&lt;/b&gt; (OrderPlaced, OrderAccepted, ...)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="860" height="45" as="geometry"/></mxCell>
        <mxCell id="b14" value="&lt;b&gt;place-order/&lt;/b&gt;&lt;br&gt;&lt;br&gt;endpoint&lt;br&gt;request + validation&lt;br&gt;handler: price via&lt;br&gt;Restaurants API,&lt;br&gt;save, authorise&lt;br&gt;test" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="200" width="160" height="250" as="geometry"/></mxCell>
        <mxCell id="b15" value="&lt;b&gt;accept-order/&lt;/b&gt;&lt;br&gt;&lt;br&gt;endpoint&lt;br&gt;handler: Order.accept()&lt;br&gt;-&amp;gt; Payments.capture&lt;br&gt;test" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="832" y="200" width="160" height="250" as="geometry"/></mxCell>
        <mxCell id="b16" value="&lt;b&gt;reject-order/&lt;/b&gt;&lt;br&gt;&lt;br&gt;endpoint&lt;br&gt;handler: Order.reject()&lt;br&gt;-&amp;gt; Payments.void&lt;br&gt;test" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1004" y="200" width="160" height="250" as="geometry"/></mxCell>
        <mxCell id="b17" value="&lt;b&gt;track-order/&lt;/b&gt;&lt;br&gt;&lt;br&gt;endpoint&lt;br&gt;query: SELECT status&lt;br&gt;-&amp;gt; DTO&lt;br&gt;test" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1176" y="200" width="160" height="250" as="geometry"/></mxCell>
        <mxCell id="b18" value="&lt;b&gt;list-my-orders/&lt;/b&gt;&lt;br&gt;&lt;br&gt;endpoint&lt;br&gt;query: paged SELECT&lt;br&gt;-&amp;gt; DTO&lt;br&gt;(no domain class)&lt;br&gt;test" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=top;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1348" y="200" width="160" height="250" as="geometry"/></mxCell>
        <mxCell id="b19" value="&lt;b&gt;domain/Order.ts&lt;/b&gt; - shared INSIDE the module only: the order state machine and its rules&lt;br&gt;(pure code, no database or HTTP - easy to test; idea borrowed from A-Frame / DDD aggregate)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="500" width="680" height="70" as="geometry"/></mxCell>
        <mxCell id="b20" value="&lt;b&gt;ordering schema&lt;/b&gt;&lt;br&gt;(owned only by this module)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;spacingTop=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1"><mxGeometry x="660" y="620" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="e21" value="uses rules" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" value="uses rules" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b15" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="uses rules" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b16" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" value="plain query" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="600"/><mxPoint x="1000" y="600"/><mxPoint x="1000" y="653"/></Array></mxGeometry></mxCell>
        <mxCell id="e25" value="plain query" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1577" y="700"/><mxPoint x="960" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="e26" value="saved by handler" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b19" target="b20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="public API delegates to slices" style="html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b13" target="b15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t28" value="Rules: a slice owns its whole use case (HTTP -&amp;gt; DB). Simple reads stay plain queries. Real business rules live once, in the shared domain model. Interfaces only at external systems and the module API. Other modules may use ONLY OrderingApi.ts / events.ts - enforced by an architecture test in the build (D3)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="780" width="900" height="50" as="geometry"/></mxCell>
        <mxCell id="b29" value="&lt;b&gt;Folder layout&lt;/b&gt;&lt;br&gt;src/modules/ordering/&lt;br&gt;&amp;nbsp;&amp;nbsp;OrderingApi.ts&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(public)&lt;br&gt;&amp;nbsp;&amp;nbsp;events.ts&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (public)&lt;br&gt;&amp;nbsp;&amp;nbsp;domain/Order.ts&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (shared in module)&lt;br&gt;&amp;nbsp;&amp;nbsp;features/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;place-order/&amp;nbsp;&amp;nbsp;accept-order/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;reject-order/&amp;nbsp;&amp;nbsp;track-order/ ...&lt;br&gt;&amp;nbsp;&amp;nbsp;data/schema.sql&lt;br&gt;src/modules/payments/&lt;br&gt;&amp;nbsp;&amp;nbsp;provider/PaymentProvider.ts&amp;nbsp;&amp;nbsp;(port)&lt;br&gt;&amp;nbsp;&amp;nbsp;provider/StripePaymentProvider.ts (adapter)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;rounded=0;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;spacingTop=4;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="560" height="230" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
